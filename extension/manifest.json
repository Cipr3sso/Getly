{
  "manifest_version": 3,
  "name": "Getly Browser Integration",
  "version": "1.0.0",
  "description": "Intercetta automaticamente i download del browser e li invia a Getly via Native Messaging.",
  "permissions": [
    "downloads",
    "nativeMessaging",
    "storage",
    "cookies",
    "contextMenus"
  ],
  "host_permissions": [
    "http://127.0.0.1:9666/*",
    "http://localhost:9666/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Getly",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}

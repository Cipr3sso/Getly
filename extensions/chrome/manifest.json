{
  "manifest_version": 3,
  "name": "Getly - Download Manager & Video Sniffer",
  "version": "1.0.0",
  "description": "Integrazione browser per Getly: cattura automatica dei download, sniffer multimediale/video HLS/DASH e menu contestuale.",
  "permissions": [
    "downloads",
    "webRequest",
    "storage",
    "activeTab",
    "contextMenus",
    "cookies"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Getly Downloader",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}

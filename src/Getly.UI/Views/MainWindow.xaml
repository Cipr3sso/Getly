<Window
    x:Class="Getly.UI.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Getly.UI.ViewModels"
    Title="Getly Download Manager"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="Base" />
    </Window.SystemBackdrop>

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <!-- App Title Bar -->
            <RowDefinition Height="44" />
            <!-- Main Content Area with Navigation Rail -->
            <RowDefinition Height="*" />
            <!-- Bottom Status Bar -->
            <RowDefinition Height="32" />
        </Grid.RowDefinitions>

        <!-- Custom Title Bar (Assigned via SetTitleBar in MainWindow.xaml.cs) -->
        <Grid
            x:Name="AppTitleBar"
            Grid.Row="0"
            Height="44"
            Background="Transparent"
            Padding="16,0,16,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                <FontIcon Glyph="&#xE896;" FontSize="14" Foreground="#3B82F6" />
                <TextBlock Text="Getly" FontWeight="SemiBold" FontSize="12" Foreground="#FFFFFF" VerticalAlignment="Center" />
                <Border Background="#20FFFFFF" BorderBrush="#30FFFFFF" BorderThickness="1" CornerRadius="4" Padding="6,2,6,2" VerticalAlignment="Center">
                    <TextBlock Text="v1.0 Preview" FontSize="10" Foreground="#9CA3AF" FontWeight="Medium" />
                </Border>
            </StackPanel>
        </Grid>

        <!-- Main Body: Navigation View & Download DataGrid -->
        <NavigationView
            Grid.Row="1"
            x:Name="NavView"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="True"
            IsPaneToggleButtonVisible="True"
            PaneDisplayMode="Auto"
            OpenPaneLength="200"
            CompactPaneLength="48"
            ExpandedModeThresholdWidth="1000"
            CompactModeThresholdWidth="800"
            SelectionChanged="NavView_SelectionChanged"
            ItemInvoked="NavView_ItemInvoked">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Tutti i download" Tag="ALL">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE896;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="In corso" Tag="DOWNLOADING">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE768;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Completati" Tag="COMPLETED">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE73E;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Torrent / P2P" Tag="TORRENT">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE774;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <!-- Main Content: Command Bar + Data List -->
            <Grid Padding="16,12,16,8" RowSpacing="10">
                <Grid.RowDefinitions>
                    <!-- Command Bar -->
                    <RowDefinition Height="Auto" />
                    <!-- List Header -->
                    <RowDefinition Height="34" />
                    <!-- Task List View -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Command Bar & Search Box -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Responsive WinUI 3 CommandBar -->
                    <CommandBar
                        Grid.Column="0"
                        DefaultLabelPosition="Right"
                        IsDynamicOverflowEnabled="True"
                        Background="Transparent">
                        <AppBarButton Icon="Add" Label="Nuovo Download" Click="OnAddDownloadClick" />
                        <AppBarSeparator />
                        <AppBarButton Icon="Play" Label="Riprendi" Command="{x:Bind ViewModel.ResumeTaskCommand}" CommandParameter="{x:Bind ViewModel.SelectedTask, Mode=OneWay}" />
                        <AppBarButton Icon="Pause" Label="Pausa" Command="{x:Bind ViewModel.PauseTaskCommand}" CommandParameter="{x:Bind ViewModel.SelectedTask, Mode=OneWay}" />
                        <AppBarButton Icon="Delete" Label="Elimina" Command="{x:Bind ViewModel.DeleteTaskCommand}" CommandParameter="{x:Bind ViewModel.SelectedTask, Mode=OneWay}" />
                    </CommandBar>

                    <!-- Search Input -->
                    <AutoSuggestBox
                        Grid.Column="1"
                        MinWidth="180"
                        Width="240"
                        VerticalAlignment="Center"
                        PlaceholderText="Cerca tra i download..."
                        QueryIcon="Find"
                        Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>

                <!-- Table Header Row -->
                <Border Grid.Row="1" Background="#18FFFFFF" CornerRadius="6" Padding="12,0,12,0">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="140" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="#" FontSize="11" Foreground="#9CA3AF" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="Nome File" FontSize="11" Foreground="#9CA3AF" FontWeight="SemiBold" Margin="4,0,0,0" />
                        <TextBlock Grid.Column="2" Text="Categoria" FontSize="11" Foreground="#9CA3AF" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="3" Text="Dimensione" FontSize="11" Foreground="#9CA3AF" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="4" Text="Velocità / Stato" FontSize="11" Foreground="#9CA3AF" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="5" Text="Avanzamento" FontSize="11" Foreground="#9CA3AF" FontWeight="SemiBold" />
                    </Grid>
                </Border>

                <!-- Task List View -->
                <ListView
                    Grid.Row="2"
                    ItemsSource="{x:Bind ViewModel.FilteredTasks, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.SelectedTask, Mode=TwoWay}"
                    SelectionMode="Single">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,2,0,2" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:TaskItemViewModel">
                            <Border
                                Background="#262626"
                                BorderBrush="#383838"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12,8,12,8"
                                DoubleTapped="OnRowDoubleTapped">
                                <Border.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="Avvia / Riprendi" Icon="Play" Click="OnResumeTaskClick" />
                                        <MenuFlyoutItem Text="Pausa" Icon="Pause" Click="OnPauseTaskClick" />
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Text="Mostra nella cartella" Icon="Folder" Click="OnOpenFolderClick" />
                                        <MenuFlyoutItem Text="Apri file" Icon="OpenFile" Click="OnOpenFileClick" />
                                        <MenuFlyoutItem Text="Copia URL sorgente" Icon="Copy" Click="OnCopyUrlClick" />
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Text="Rimuovi dalla lista" Icon="Delete" Click="OnRemoveFromListClick" />
                                        <MenuFlyoutItem Text="Elimina file da disco" Icon="Cancel" Click="OnDeleteFromDiskClick" />
                                    </MenuFlyout>
                                </Border.ContextFlyout>
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="140" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Status Glyph Icon -->
                                    <FontIcon Grid.Column="0" Glyph="{x:Bind StatusIconGlyph, Mode=OneWay}" FontSize="16" Foreground="{x:Bind StatusColor, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center" />

                                    <!-- File Name & Source URL -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Padding="4,0,10,0">
                                        <TextBlock Text="{x:Bind Filename, Mode=OneWay}" FontWeight="SemiBold" FontSize="12" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind Url, Mode=OneWay}" FontSize="10" Foreground="#888888" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <!-- Category Badge with Custom Opacity and Color -->
                                    <Border Grid.Column="2" Background="{x:Bind CategoryBackground, Mode=OneWay}" CornerRadius="10" Padding="8,3,8,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Category, Mode=OneWay}" FontSize="10" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                    </Border>

                                    <!-- Downloaded / Total Size -->
                                    <TextBlock Grid.Column="3" Text="{x:Bind DownloadedFormatted, Mode=OneWay}" FontSize="11" Foreground="#CCCCCC" VerticalAlignment="Center" />

                                    <!-- Live Speed & Status Description -->
                                    <StackPanel Grid.Column="4" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{x:Bind SpeedFormatted, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" Foreground="{x:Bind StatusColor, Mode=OneWay}" />
                                        <TextBlock Text="{x:Bind StatusDisplay, Mode=OneWay}" FontSize="10" Foreground="#AAAAAA" />
                                    </StackPanel>

                                    <!-- Progress Bar & % / ETA -->
                                    <StackPanel Grid.Column="5" VerticalAlignment="Center" Spacing="3">
                                        <ProgressBar Value="{x:Bind Progress, Mode=OneWay}" Minimum="0" Maximum="100" Height="4" Foreground="{x:Bind StatusColor, Mode=OneWay}" Background="#333333" />
                                        <Grid>
                                            <TextBlock Text="{x:Bind ProgressPercentageFormatted, Mode=OneWay}" FontSize="10" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Left" />
                                            <TextBlock Text="{x:Bind EtaFormatted, Mode=OneWay}" FontSize="10" Foreground="#888888" HorizontalAlignment="Right" />
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </NavigationView>

        <!-- Bottom Status Bar -->
        <Border Grid.Row="2" Background="#14FFFFFF" BorderBrush="#22FFFFFF" BorderThickness="0,1,0,0" Padding="16,0,16,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Aggregate Throughput -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="⬇ DL:" FontSize="11" Foreground="#60A5FA" FontWeight="SemiBold" />
                        <TextBlock Text="{x:Bind ViewModel.AggregateDownloadSpeed, Mode=OneWay}" FontSize="11" Foreground="#FFFFFF" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="⬆ UL:" FontSize="11" Foreground="#34D399" FontWeight="SemiBold" />
                        <TextBlock Text="{x:Bind ViewModel.AggregateUploadSpeed, Mode=OneWay}" FontSize="11" Foreground="#FFFFFF" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="Totale:" FontSize="11" Foreground="#9CA3AF" />
                        <TextBlock Text="{x:Bind ViewModel.TotalDownloaded, Mode=OneWay}" FontSize="11" Foreground="#D1D5DB" />
                    </StackPanel>
                </StackPanel>

                <!-- Center: Active Interfaces Summary -->
                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.ActiveAdaptersSummary, Mode=OneWay}" FontSize="11" Foreground="#6B7280" HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                <!-- Right: VPN Shield & Connection Status -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Border Background="#1010B981" BorderBrush="#10B981" BorderThickness="1" CornerRadius="4" Padding="6,2,6,2">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon Glyph="&#xE72E;" FontSize="10" Foreground="#10B981" />
                            <TextBlock Text="{x:Bind ViewModel.VpnShieldStatusText, Mode=OneWay}" FontSize="10" Foreground="#10B981" FontWeight="Medium" />
                        </StackPanel>
                    </Border>

                    <Border Background="#153B82F6" CornerRadius="4" Padding="6,2,6,2">
                        <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" FontSize="10" Foreground="#93C5FD" />
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
